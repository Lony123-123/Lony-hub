    -- CHUỘT TRÁI: Chọn / Bỏ chọn Ưu tiên (Màu xanh)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local clickedPlayer = getPlayerAtMouse()
        if not clickedPlayer then return end

        if ignoredPlayers[clickedPlayer] then
            print(clickedPlayer.Name .. " đang ở danh sách Bỏ qua (Đỏ)! Hãy click chuột phải lần nữa để gỡ trước.")
            return
        end

        if priorityTarget == clickedPlayer then
            clearPriorityTarget()
            print("Đã hủy ưu tiên cho: " .. clickedPlayer.Name)
        else
            priorityTarget = clickedPlayer
            updatePriorityHighlight()
            print("Đã ưu tiên 1 trái bom (Xanh) cho: " .. clickedPlayer.Name)
        end

    -- CHUỘT PHẢI: Ghi nhận vị trí bắt đầu nhấn để phân biệt giữa Click chọn và Giữ xoay camera
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        rightClickStartPos = UIS:GetMouseLocation()
        rightClickStartTime = tick()
    end
end)

UIS.InputEnded:Connect(function(input, gameProcessed)
    if not charityActive then return end

    if input.UserInputType == Enum.UserInputType.MouseButton2 and rightClickStartPos then
        local moveDist = (UIS:GetMouseLocation() - rightClickStartPos).Magnitude
        local holdTime = tick() - rightClickStartTime
        rightClickStartPos = nil

        if holdTime < 0.3 and moveDist < 12 then
            local clickedPlayer = getPlayerAtMouse()
            if not clickedPlayer then return end

            if priorityTarget == clickedPlayer then
                print(clickedPlayer.Name .. " đang được Ưu tiên (Xanh)! Hãy click chuột trái lần nữa để gỡ trước.")
                return
            end

            if ignoredPlayers[clickedPlayer] then
                setIgnoredPlayer(clickedPlayer, false)
                print("Đã gỡ bỏ qua, đưa " .. clickedPlayer.Name .. " trở lại danh sách Random.")
            else
                setIgnoredPlayer(clickedPlayer, true)
                print("Đã bỏ qua hoàn toàn (Đỏ): " .. clickedPlayer.Name)
            end
        end
    end
end)

local function charityTargets(bombName)
    local targets = {}
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if isTargetValid(targetPlayer, bombName) then
            table.insert(targets, targetPlayer)
        end
    end
    for i = #targets, 2, -1 do
        local j = math.random(1, i)
        targets[i], targets[j] = targets[j], targets[i]
    end
    return targets
end

local function charityGetBomb(bombName, ignoredTools)
    local c = character()
    local backpack = player:FindFirstChild("Backpack")
    local containers = {c, backpack}
    for _, container in pairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and (bombName and item.Name == bombName
                    or not bombName and not ignoredTools[item.Name]) then
                    return item
                end
            end
        end
    end
    return nil
end

local function runCharityBomb()
    local ignoredTools = {}
    for _, container in ipairs({character(), player:FindFirstChild("Backpack")}) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and item.Name ~= "Classic Timebomb" then
                    ignoredTools[item.Name] = true
                end
            end
        end
    end

    charityWasNoclip = noclip
    setNoclip(true)
    startFreecam()

    -- Bật vòng lặp lấy bom liên tục bằng firetouchinterest (thay cho tele 2 chỗ)
    _G.AutoBomb = true
    task.spawn(function()
        while _G.AutoBomb and charityActive do
            local hrp = root()
            local handle = getBombHandle()

            if hrp and handle and firetouchinterest then
                firetouchinterest(hrp, handle, 0)
                task.wait(0.02)
                firetouchinterest(hrp, handle, 1)
            end

            task.wait(0.1) -- Lấy liên tục 10 lần mỗi giây
        end
    end)

    local bombName

    local function findBomb()
        while charityActive and _G.AutoBomb do
            local bomb = charityGetBomb(bombName, ignoredTools)
            if bomb then return bomb end
            if bombName and #charityTargets(bombName) == 0 then return nil end
            task.wait(0.05)
        end
        return nil
    end

    while charityActive do
        if #charityTargets(bombName) == 0 then break end
        local bomb = charityGetBomb(bombName, ignoredTools) or findBomb()
        if not charityActive or not bomb then break end
        if not bombName then
            bombName = bomb.Name
            print("Đã nhận diện tên bom: " .. bombName)
        end

        local targetPlayer = nil

        if priorityTarget then
            if isTargetValid(priorityTarget, bombName) then
                targetPlayer = priorityTarget
                print("Đang chuyền bom ƯU TIÊN cho: " .. targetPlayer.Name)
            else
                clearPriorityTarget()
            end
        end

        if not targetPlayer then
            local targets = charityTargets(bombName)
            if #targets == 0 then break end
            targetPlayer = targets[1]
            print("Đang chuyền bom cho: " .. targetPlayer.Name)
        end

        while charityActive and charityGetBomb(bombName, ignoredTools) == bomb do
            if ignoredPlayers[targetPlayer] then
                break
            end

            if priorityTarget and priorityTarget ~= targetPlayer then
                if isTargetValid(priorityTarget, bombName) then
                    break
                else
                    clearPriorityTarget()
                end
            end

            local myRoot = root()
            local targetRoot = charityRoot(targetPlayer)
            if targetPlayer.Parent ~= Players or not targetRoot or not myRoot
                or not charityHealthy(targetPlayer) or charityHasBomb(targetPlayer, bombName) then
                break
            end

            local c = character()
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h and bomb.Parent == player:FindFirstChild("Backpack") then
                h:EquipTool(bomb)
            end
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, charityBehindDistance)
            RunService.Heartbeat:Wait()
        end

        if targetPlayer == priorityTarget and (not isTargetValid(priorityTarget, bombName) or charityGetBomb(bombName, ignoredTools) ~= bomb) then
            clearPriorityTarget()
        end

        task.wait(0.05)
    end

    local completed = charityActive
    charityActive = false
    _G.AutoBomb = false
    clearAllSelections()
    if setCharityVisual then setCharityVisual(false) end
    setNoclip(charityWasNoclip)

    if completed then
        local finalRoot = root()
        if finalRoot then
            finalRoot.AssemblyLinearVelocity = Vector3.zero
        end
        print("Đã hoàn tất!")
    else
        print("Đã tắt Từ thiện bom.")
    end

    stopFreecam()
end

local function setCharityEnabled(enabled)
    if enabled == charityActive then return end
    charityActive = enabled
    _G.AutoBomb = enabled

    if setCharityVisual then setCharityVisual(enabled) end

    if enabled then
        task.spawn(runCharityBomb)
    else
        clearAllSelections()
        stopFreecam()
    end
end

setCharityVisual = CreateCheckbox("Từ thiện bom", 1, function()
    setCharityEnabled(not charityActive)
end)

-- ================= LOGIC ATOMIC LAZER (NÚT SỐ 2 - GOM SERVER & HOOK ĐẠN) =================
local isGathering = false
local setAtomicVisual
local gatherConnection = nil
local currentGatherPos = nil
local originalStates = {}
local GATHER_OFFSET = 12 -- Khoảng cách gom an toàn trước mặt (12 studs)

local sharedEnv = (getgenv and getgenv()) or _G
sharedEnv.LonyAtomicGathering = false
sharedEnv.LonyCurrentGatherPos = nil

local function maximizeNetworkRange()
    pcall(function()
        if typeof(sethiddenproperty) == "function" then
            sethiddenproperty(player, "SimulationRadius", math.huge)
            sethiddenproperty(player, "MaxSimulationRadius", math.huge)
        end
    end)
end

-- Kiểm tra bảo vệ tuyệt đối bản thân (0% tự sát)
local function isSelf(obj)
    if not obj then return true end
    local myChar = player.Character
    if myChar and (obj == myChar or obj:IsDescendantOf(myChar)) then
        return true
    end
    if obj.Name == player.Name or obj.Name == player.DisplayName then
        return true
    end
    if Players:GetPlayerFromCharacter(obj) == player then
        return true
    end
    return false
end

-- Lấy danh sách toàn bộ đối thủ còn sống trên Server
local function getAllTargetsMaxRange()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and not isSelf(plr.Character) then
            local char = plr.Character
            local targetRoot = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if targetRoot and hum and hum.Health > 0 and not char:FindFirstChildOfClass("ForceField") then
                table.insert(list, {
                    Character = char,
                    Root = targetRoot
                })
            end
        end
    end
    return list
end

-- 1. TỰ ĐỘNG BÁO CHẠM ĐẠN LÊN SERVER KHI ĐANG BẬT CHẾ ĐỘ GOM
if sharedEnv.LonyChildAddedConn then
    sharedEnv.LonyChildAddedConn:Disconnect()
end
sharedEnv.LonyChildAddedConn = Workspace.ChildAdded:Connect(function(child)
    if isGathering and child.Name == "Effect" and child:IsA("BasePart") then
        task.defer(function()
            maximizeNetworkRange()
            local targets = getAllTargetsMaxRange()
            if #targets == 0 then return end

            child.CanCollide = false

            -- Tắt va chạm giữa viên đạn và bản thân
            local myChar = player.Character
            if myChar then
                for _, myPart in ipairs(myChar:GetDescendants()) do
                    if myPart:IsA("BasePart") then
                        pcall(function()
                            local noCol = Instance.new("NoCollisionConstraint")
                            noCol.Part0 = child
                            noCol.Part1 = myPart
                            noCol.Parent = child
                        end)
                    end
                end
            end

            -- Báo chạm (firetouchinterest) vào toàn bộ đối thủ đang bị gom
            if typeof(firetouchinterest) == "function" then
                for _, data in ipairs(targets) do
                    if not isSelf(data.Character) then
                        for _, part in ipairs(data.Character:GetChildren()) do
                            if part:IsA("BasePart") and not isSelf(part) then
                                task.spawn(function()
                                    firetouchinterest(child, part, 0)
                                    firetouchinterest(child, part, 1)
                                end)
                            end
                        end
                    end
                end
            end

            local startTime = os.clock()
            while isGathering and child and child.Parent and (os.clock() - startTime < 0.35) do
                for _, data in ipairs(targets) do
                    if data.Root and data.Root.Parent and not isSelf(data.Root) then
                        if typeof(firetouchinterest) == "function" then
                            firetouchinterest(child, data.Root, 0)
                            firetouchinterest(child, data.Root, 1)
                        end
                    end
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end
end)

-- 2. HOOK SÚNG: Khi đang bật gom, bắn đi đâu đạn cũng tự găm thẳng vào cục gom (chỉ hook 1 lần tránh lỗi đè)
if typeof(hookmetamethod) == "function" and not sharedEnv.LonyAtomicHooked then
    sharedEnv.LonyAtomicHooked = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if not checkcaller() and sharedEnv.LonyAtomicGathering and sharedEnv.LonyCurrentGatherPos and self.Name == "ServerControl" and (method == "InvokeServer" or method == "FireServer") then
            if args[1] == "Click" and args[2] == true then
                args[3] = sharedEnv.LonyCurrentGatherPos
                return oldNamecall(self, unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end)
end

-- 3. HÀM TẮT GOM (Trả mọi người về trạng thái bình thường)
local function stopGathering()
    if not isGathering then return end
    isGathering = false
    sharedEnv.LonyAtomicGathering = false
    if setAtomicVisual then setAtomicVisual(false) end

    if gatherConnection then
        gatherConnection:Disconnect()
        gatherConnection = nil
    end

    for targetRoot, state in pairs(originalStates) do
        if targetRoot and targetRoot.Parent then
            pcall(function()
                targetRoot.Size = state.Size
                targetRoot.Transparency = state.Transparency
                targetRoot.CanCollide = state.CanCollide
                local hum = targetRoot.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    targetRoot.CFrame = state.CFrame
                end
            end)
        end
    end

    table.clear(originalStates)
    currentGatherPos = nil
    sharedEnv.LonyCurrentGatherPos = nil
    notify("ĐÃ TẮT GOM [E]", "Đã thả toàn bộ người chơi ra!")
end

-- 4. HÀM BẬT GOM (Gom liên tục toàn server về trước mặt)
local function startGathering()
    if isGathering then return end
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myChar or not myRoot then
        notify("LỖI", "Chưa tìm thấy nhân vật để gom!")
        if setAtomicVisual then setAtomicVisual(false) end
        return
    end

    isGathering = true
    sharedEnv.LonyAtomicGathering = true
    if setAtomicVisual then setAtomicVisual(true) end
    maximizeNetworkRange()
    table.clear(originalStates)

    notify("ĐANG GOM SERVER [E]", "Đang giữ toàn bộ Server trước mặt! Bấm [E] hoặc tắt trên Menu để thả.")

    gatherConnection = RunService.RenderStepped:Connect(function()
        if not isGathering then return end

        local char = player.Character
        local r = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not r then return end

        -- Điểm gom luôn nằm trước mặt nhân vật 12 studs
        currentGatherPos = (r.CFrame * CFrame.new(0, 0, -GATHER_OFFSET)).Position
        sharedEnv.LonyCurrentGatherPos = currentGatherPos
        local gatherCFrame = CFrame.new(currentGatherPos)

        local targets = getAllTargetsMaxRange()
        for _, data in ipairs(targets) do
            local targetRoot = data.Root
            if targetRoot and targetRoot.Parent and not isSelf(targetRoot) then
                if not originalStates[targetRoot] then
                    originalStates[targetRoot] = {
                        CFrame = targetRoot.CFrame,
                        Size = targetRoot.Size,
                        Transparency = targetRoot.Transparency,
                        CanCollide = targetRoot.CanCollide
                    }
                end

                targetRoot.CanCollide = false
                targetRoot.Size = Vector3.new(6, 6, 6)
                targetRoot.Transparency = 0.8
                targetRoot.AssemblyLinearVelocity = Vector3.zero
                targetRoot.AssemblyAngularVelocity = Vector3.zero
                targetRoot.CFrame = gatherCFrame
            end
        end
    end)
end

local function setAtomicEnabled(enabled)
    if enabled then
        startGathering()
    else
        stopGathering()
    end
end

