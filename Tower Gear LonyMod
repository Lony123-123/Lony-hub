local function charityHealthy(targetPlayer)
	local c = targetPlayer and targetPlayer.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.MaxHealth > 0 and h.Health > 1 and (h.Health / h.MaxHealth) * 100 > 1
end

local function charityHasBomb(targetPlayer, bombName)
	if not targetPlayer or not bombName then return false end
	local c = targetPlayer.Character
	local backpack = targetPlayer:FindFirstChild("Backpack")
	return (c and c:FindFirstChild(bombName) ~= nil)
		or (backpack and backpack:FindFirstChild(bombName) ~= nil) or false
end

-- Kiểm tra mục tiêu hợp lệ (không nằm trong danh sách bị chuột phải bỏ qua)
local function isTargetValid(targetPlayer, bombName)
	return targetPlayer ~= nil
		and targetPlayer ~= player
		and targetPlayer.Parent == Players
		and not ignoredPlayers[targetPlayer]
		and charityRoot(targetPlayer) ~= nil
		and charityHealthy(targetPlayer)
		and (not bombName or not charityHasBomb(targetPlayer, bombName))
end

-- Hàm dò tìm người chơi dưới con trỏ chuột (hỗ trợ cả Raycast trực tiếp lẫn chọn xuyên tường theo góc nhìn)
local function getPlayerAtMouse()
	local cam = workspace.CurrentCamera
	if not cam then return nil end

	local mousePos = UIS:GetMouseLocation()
	local unitRay = cam:ViewportPointToRay(mousePos.X, mousePos.Y)

	-- 1. Ưu tiên Raycast trực tiếp nếu nhìn thấy
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	if character() then
		rayParams.FilterDescendantsInstances = {character()}
	end

	local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 3000, rayParams)
	if result and result.Instance then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character and result.Instance:IsDescendantOf(p.Character) then
				return p
			end
		end
	end

	-- 2. Nếu bị tường chắn (do Highlight xuyên tường), tìm người chơi khớp tâm chuột nhất trên màn hình (bán kính 35px)
	local closestPlayer = nil
	local shortestDist = 35
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
				if onScreen then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						closestPlayer = p
					end
				end
			end
		end
	end

	return closestPlayer
end

-- Xử lý Chuột trái (Ưu tiên - Xanh) & Chuột phải (Bỏ qua - Đỏ)
local rightClickStartPos = nil
local rightClickStartTime = 0

UIS.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not charityActive then return end

	-- CHUỘT TRÁI: Chọn / Bỏ chọn Ưu tiên (Màu xanh)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local clickedPlayer = getPlayerAtMouse()
		if not clickedPlayer then return end

		-- Nếu người này đang bị Bỏ qua (Màu đỏ) thì khóa không cho bấm chuột trái
		if ignoredPlayers[clickedPlayer] then
			print(clickedPlayer.Name .. " đang ở danh sách Bỏ qua (Đỏ)! Hãy click chuột phải lần nữa để gỡ trước.")
			return
		end

		-- Nếu bấm chuột trái lần nữa vào đúng người đang Ưu tiên -> Bỏ chọn
		if priorityTarget == clickedPlayer then
			clearPriorityTarget()
			print("Đã hủy ưu tiên cho: " .. clickedPlayer.Name)
		else
			priorityTarget = clickedPlayer
			updatePriorityHighlight()
			print("Đã ưu tiên 1 trái bom (Xanh) cho: " .. clickedPlayer.Name)
		end

	-- CHUỘT PHẢI: Ghi nhận vị trí bắt đầu nhấn để phân biệt giữa Click chọn và Giữ xoay camera
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		rightClickStartPos = UIS:GetMouseLocation()
		rightClickStartTime = tick()
	end
end)

UIS.InputEnded:Connect(function(input, gameProcessed)
	if not charityActive then return end

	-- Khi nhả Chuột phải: Nếu thời gian nhấn < 0.25s và chuột không kéo đi xa -> Tính là Click chuột phải
	if input.UserInputType == Enum.UserInputType.MouseButton2 and rightClickStartPos then
		local moveDist = (UIS:GetMouseLocation() - rightClickStartPos).Magnitude
		local holdTime = tick() - rightClickStartTime
		rightClickStartPos = nil

		if holdTime < 0.3 and moveDist < 12 then
			local clickedPlayer = getPlayerAtMouse()
			if not clickedPlayer then return end

			-- Nếu người này đang được Ưu tiên (Màu xanh) thì khóa không cho bấm chuột phải
			if priorityTarget == clickedPlayer then
				print(clickedPlayer.Name .. " đang được Ưu tiên (Xanh)! Hãy click chuột trái lần nữa để gỡ trước.")
				return
			end

			-- Bật / Tắt trạng thái Bỏ qua (Màu đỏ)
			if ignoredPlayers[clickedPlayer] then
				setIgnoredPlayer(clickedPlayer, false)
				print("Đã gỡ bỏ qua, đưa " .. clickedPlayer.Name .. " trở lại danh sách Random.")
			else
				setIgnoredPlayer(clickedPlayer, true)
				print("Đã bỏ qua hoàn toàn (Đỏ): " .. clickedPlayer.Name)
			end
		end
	end
end)

local function charityTargets(bombName)
	local targets = {}
	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if isTargetValid(targetPlayer, bombName) then
			table.insert(targets, targetPlayer)
		end
	end
	for i = #targets, 2, -1 do
		local j = math.random(1, i)
		targets[i], targets[j] = targets[j], targets[i]
	end
	return targets
end

local function charityGetBomb(bombName, ignoredTools)
	local c = character()
	local backpack = player:FindFirstChild("Backpack")
	local containers = {c, backpack}
	for _, container in pairs(containers) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and (bombName and item.Name == bombName
					or not bombName and not ignoredTools[item.Name]) then
					return item
				end
			end
		end
	end
	return nil
end

local function runCharityBomb()
	local ignoredTools = {}
	for _, container in ipairs({character(), player:FindFirstChild("Backpack")}) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") then ignoredTools[item.Name] = true end
			end
		end
	end

	charityWasNoclip = noclip
	setNoclip(true)
	startFreecam()

	local bombName
	local posToggle = false

	local function findBombOrMove()
		while charityActive do
			local bomb = charityGetBomb(bombName, ignoredTools)
			if bomb then return bomb end
			if bombName and #charityTargets(bombName) == 0 then return nil end
			local r = root()
			if r then
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
				r.CFrame = CFrame.new(posToggle and charityPos1 or charityPos2)
				posToggle = not posToggle
			end
			task.wait(0.1)
		end
		return nil
	end

	while charityActive do
		if #charityTargets(bombName) == 0 then break end
		local bomb = charityGetBomb(bombName, ignoredTools) or findBombOrMove()
		if not charityActive or not bomb then break end
		if not bombName then
			bombName = bomb.Name
			print("Đã nhận diện tên bom: " .. bombName)
		end

		local targetPlayer = nil

		-- Kiểm tra nếu có người chơi đang được click ưu tiên (Màu xanh) và người đó hợp lệ
		if priorityTarget then
			if isTargetValid(priorityTarget, bombName) then
				targetPlayer = priorityTarget
				print("Đang chuyền bom ƯU TIÊN cho: " .. targetPlayer.Name)
			else
				clearPriorityTarget()
			end
		end

		-- Nếu không có mục tiêu ưu tiên thì lấy ngẫu nhiên trong những người không bị bỏ qua
		if not targetPlayer then
			local targets = charityTargets(bombName)
			if #targets == 0 then break end
			targetPlayer = targets[1]
			print("Đang chuyền bom cho: " .. targetPlayer.Name)
		end

		while charityActive and charityGetBomb(bombName, ignoredTools) == bomb do
			-- 1. Nếu mục tiêu hiện tại vừa bị bạn click Chuột phải (đưa vào danh sách Đỏ) -> Bỏ ngang ngay lập tức
			if ignoredPlayers[targetPlayer] then
				break
			end

			-- 2. Nếu bạn vừa click Chuột trái ưu tiên một người mới -> Đổi sang người ưu tiên ngay lập tức
			if priorityTarget and priorityTarget ~= targetPlayer then
				if isTargetValid(priorityTarget, bombName) then
					break
				else
					clearPriorityTarget()
				end
			end

			local myRoot = root()
			local targetRoot = charityRoot(targetPlayer)
			if targetPlayer.Parent ~= Players or not targetRoot or not myRoot
				or not charityHealthy(targetPlayer) or charityHasBomb(targetPlayer, bombName) then
				break
			end

			local c = character()
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if h and bomb.Parent == player:FindFirstChild("Backpack") then
				h:EquipTool(bomb)
			end
			myRoot.AssemblyLinearVelocity = Vector3.zero
			myRoot.AssemblyAngularVelocity = Vector3.zero
			myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, charityBehindDistance)
			RunService.Heartbeat:Wait()
		end

		-- Sau khi tặng xong 1 trái cho người ưu tiên (hoặc người đó không còn hợp lệ), tự gỡ trạng thái ưu tiên
		if targetPlayer == priorityTarget and (not isTargetValid(priorityTarget, bombName) or charityGetBomb(bombName, ignoredTools) ~= bomb) then
			clearPriorityTarget()
		end

		task.wait(0.05)
	end

	local completed = charityActive
	charityActive = false
	clearAllSelections()
	if setCharityVisual then setCharityVisual(false) end
	setNoclip(charityWasNoclip)

	if completed then
		local finalRoot = root()
		if finalRoot then
			finalRoot.AssemblyLinearVelocity = Vector3.zero
			finalRoot.CFrame = CFrame.new(charityPos1)
		end
		print("Đã hoàn tất!")
	else
		print("Đã tắt Từ thiện bom.")
	end

	stopFreecam()
end

setCharityVisual = CreateCheckbox("Từ thiện bom", 1, function()
	if charityActive then
		charityActive = false
		clearAllSelections()
		stopFreecam()
		if setCharityVisual then setCharityVisual(false) end
		return
	end
	charityActive = true
	if setCharityVisual then setCharityVisual(true) end
	task.spawn(runCharityBomb)
end)

