local function charityRoot(targetPlayer)
    local c = targetPlayer and targetPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function charityHealthy(targetPlayer)
    local c = targetPlayer and targetPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.MaxHealth > 0 and h.Health > 1 and (h.Health / h.MaxHealth) * 100 > 1
end

local function charityHasBomb(targetPlayer, bombName)
    if not targetPlayer or not bombName then return false end
    local c = targetPlayer.Character
    local backpack = targetPlayer:FindFirstChild("Backpack")
    return (c and c:FindFirstChild(bombName) ~= nil)
        or (backpack and backpack:FindFirstChild(bombName) ~= nil) or false
end

-- Kiểm tra mục tiêu hợp lệ (không nằm trong danh sách bị chuột phải bỏ qua)
local function isTargetValid(targetPlayer, bombName)
    return targetPlayer ~= nil
        and targetPlayer ~= player
        and targetPlayer.Parent == Players
        and not ignoredPlayers[targetPlayer]
        and charityRoot(targetPlayer) ~= nil
        and charityHealthy(targetPlayer)
        and (not bombName or not charityHasBomb(targetPlayer, bombName))
end

-- Hàm dò tìm người chơi dưới con trỏ chuột (hỗ trợ cả Raycast trực tiếp lẫn chọn xuyên tường theo góc nhìn)
local function getPlayerAtMouse()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end

    local mousePos = UIS:GetMouseLocation()
    local unitRay = cam:ViewportPointToRay(mousePos.X, mousePos.Y)

    -- 1. Ưu tiên Raycast trực tiếp nếu nhìn thấy
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    if character() then
        rayParams.FilterDescendantsInstances = {character()}
    end

    local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 3000, rayParams)
    if result and result.Instance then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and result.Instance:IsDescendantOf(p.Character) then
                return p
            end
        end
    end

    -- 2. Nếu bị tường chắn (do Highlight xuyên tường), tìm người chơi khớp tâm chuột nhất trên màn hình (bán kính 35px)
    local closestPlayer = nil
    local shortestDist = 35
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPlayer = p
                    end
                end
            end
        end
    end

    return closestPlayer
end

-- Xử lý Chuột trái (Ưu tiên - Xanh) & Chuột phải (Bỏ qua - Đỏ)
