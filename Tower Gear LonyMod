-- Hàm tạo Highlight xuyên tường (AlwaysOnTop)
local function createWallHighlight(targetChar, fillColor, outlineColor)
	local hl = Instance.new("Highlight")
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- Xuyên tường
	hl.FillColor = fillColor
	hl.OutlineColor = outlineColor
	hl.FillTransparency = 0.45
	hl.OutlineTransparency = 0
	hl.Adornee = targetChar
	hl.Parent = HighlightFolder
	return hl
end

-- Cập nhật Highlight màu xanh cho người được Ưu tiên
local function updatePriorityHighlight()
	if priorityHighlight then
		priorityHighlight:Destroy()
		priorityHighlight = nil
	end
	if priorityTarget and priorityTarget.Character then
		priorityHighlight = createWallHighlight(
			priorityTarget.Character,
			Color3.fromRGB(0, 255, 120), -- Màu xanh
			Color3.fromRGB(200, 255, 220)
		)
	end
end

local function clearPriorityTarget()
	priorityTarget = nil
	updatePriorityHighlight()
end

-- Cập nhật Highlight màu đỏ cho người nằm trong danh sách Bỏ qua
local function setIgnoredPlayer(targetPlayer, state)
	if state then
		ignoredPlayers[targetPlayer] = true
		if ignoredHighlights[targetPlayer] then
			ignoredHighlights[targetPlayer]:Destroy()
		end
		if targetPlayer.Character then
			ignoredHighlights[targetPlayer] = createWallHighlight(
				targetPlayer.Character,
				Color3.fromRGB(255, 45, 45), -- Màu đỏ
				Color3.fromRGB(255, 180, 180)
			)
		end
	else
		ignoredPlayers[targetPlayer] = nil
		if ignoredHighlights[targetPlayer] then
			ignoredHighlights[targetPlayer]:Destroy()
			ignoredHighlights[targetPlayer] = nil
		end
	end
end

local function clearAllSelections()
	clearPriorityTarget()
	for p, _ in pairs(ignoredPlayers) do
		setIgnoredPlayer(p, false)
	end
	table.clear(ignoredPlayers)
	HighlightFolder:ClearAllChildren()
end

-- Tự động gắn lại Highlight xuyên tường nếu người chơi đó hồi sinh
RunService.Heartbeat:Connect(function()
	if priorityTarget and priorityTarget.Character and priorityHighlight then
		if priorityHighlight.Adornee ~= priorityTarget.Character then
			priorityHighlight.Adornee = priorityTarget.Character
		end
	end
	for p, hl in pairs(ignoredHighlights) do
		if p and p.Parent == Players then
			if p.Character and hl.Adornee ~= p.Character then
				hl.Adornee = p.Character
			end
		else
			setIgnoredPlayer(p, false)
		end
	end
end)

-- ================= HỆ THỐNG FREECAM =================
local freecamActive = false
local freecamConnection = nil
local camYaw = 0
local camPitch = 0
local camPosition = Vector3.zero
local freecamBaseSpeed = 60
local freecamSensitivity = 0.003

local function startFreecam()
	if freecamActive then return end
	freecamActive = true

	local cam = workspace.CurrentCamera
	if not cam then return end

	cam.CameraType = Enum.CameraType.Scriptable
	camPosition = cam.CFrame.Position
	local rx, ry, _ = cam.CFrame:ToEulerAnglesYXZ()
	camPitch = rx
	camYaw = ry

	freecamConnection = RunService.RenderStepped:Connect(function(dt)
		if not freecamActive then return end
		local currentCam = workspace.CurrentCamera
		if not currentCam then return end

		if currentCam.CameraType ~= Enum.CameraType.Scriptable then
			currentCam.CameraType = Enum.CameraType.Scriptable
		end

		-- Xoay góc nhìn khi giữ chuột phải
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			local delta = UIS:GetMouseDelta()
			camYaw = camYaw - delta.X * freecamSensitivity
			camPitch = math.clamp(camPitch - delta.Y * freecamSensitivity, -math.rad(89), math.rad(89))
		else
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end

		local rotCFrame = CFrame.fromEulerAnglesYXZ(camPitch, camYaw, 0)

		-- Tính toán hướng di chuyển của Freecam
		local moveVector = Vector3.zero
		if not UIS:GetFocusedTextBox() then
			if UIS:IsKeyDown(Enum.KeyCode.W) then moveVector += rotCFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then moveVector -= rotCFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then moveVector += rotCFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then moveVector -= rotCFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then moveVector += Vector3.yAxis end
			if UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveVector -= Vector3.yAxis end
		end

		local currentSpeed = freecamBaseSpeed
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
			currentSpeed = freecamBaseSpeed * 2.5
		end

		if moveVector.Magnitude > 0 then
			camPosition = camPosition + (moveVector.Unit * currentSpeed * dt)
		end

		currentCam.CFrame = CFrame.new(camPosition) * rotCFrame
		currentCam.Focus = currentCam.CFrame
	end)
end

local function stopFreecam()
	if not freecamActive then return end
	freecamActive = false

	if freecamConnection then
		freecamConnection:Disconnect()
		freecamConnection = nil
	end

	UIS.MouseBehavior = Enum.MouseBehavior.Default

	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		local c = character()
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if h then
			cam.CameraSubject = h
		end
	end
end

-- Hỗ trợ xoay Freecam trên màn hình cảm ứng (Mobile)
UIS.TouchMoved:Connect(function(touch, processed)
	if freecamActive and not processed then
		local delta = touch.Delta
		camYaw = camYaw - delta.X * freecamSensitivity * 1.5
		camPitch = math.clamp(camPitch - delta.Y * freecamSensitivity * 1.5, -math.rad(89), math.rad(89))
	end
end)

