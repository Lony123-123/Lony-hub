        Div.Size = UDim2.new(1, 0, 0, 1)
        Div.BackgroundColor3 = Colors.MintNeon
        Div.BackgroundTransparency = 0.4
        Div.BorderSizePixel = 0
        Div.LayoutOrder = order
        Div.Parent = ContentList
    end
    local function CreateSliderWithInput(labelText, minVal, maxVal, defaultVal, order, onValueChanged)
        local Row = Instance.new("Frame")
        Row.Size = UDim2.new(1, 0, 0, 26)
        Row.BackgroundTransparency = 1
        Row.LayoutOrder = order
        Row.Parent = ContentList
        local Track = Instance.new("Frame")
        Track.Size = UDim2.new(0.54, 0, 0, 22)
        Track.Position = UDim2.new(0, 0, 0.5, 0)
        Track.AnchorPoint = Vector2.new(0, 0.5)
        Track.BackgroundColor3 = Colors.HeaderBg
        Track.BackgroundTransparency = 0.15
        Track.ClipsDescendants = true
        Track.Parent = Row
        Instance.new("UICorner", Track).CornerRadius = UDim.new(0, 6)
        local TrackStroke = Instance.new("UIStroke")
        TrackStroke.Color = Colors.MintNeon
        TrackStroke.Thickness = 1.2
        TrackStroke.Parent = Track
        local Thumb = Instance.new("Frame")
        Thumb.Size = UDim2.fromOffset(18, 18)
        Thumb.AnchorPoint = Vector2.new(0.5, 0.5)
        Thumb.Position = UDim2.new(0, 9, 0.5, 0)
        Thumb.BackgroundColor3 = Colors.MintNeon
        Thumb.BorderSizePixel = 0
        Thumb.Parent = Track
        Instance.new("UICorner", Thumb).CornerRadius = UDim.new(0, 5)
        local TrackValueLabel = Instance.new("TextLabel")
        TrackValueLabel.Size = UDim2.new(1, 0, 1, 0)
        TrackValueLabel.BackgroundTransparency = 1
        TrackValueLabel.Text = tostring(defaultVal)
        TrackValueLabel.TextColor3 = Colors.TextWhite
        TrackValueLabel.Font = Enum.Font.GothamBold
        TrackValueLabel.TextSize = 11
        TrackValueLabel.ZIndex = 2
        TrackValueLabel.Parent = Track
        local InputBox = Instance.new("TextBox")
        InputBox.Size = UDim2.new(0.22, 0, 0, 22)
        InputBox.Position = UDim2.new(0.56, 0, 0.5, 0)
        InputBox.AnchorPoint = Vector2.new(0, 0.5)
        InputBox.BackgroundColor3 = Colors.HeaderBg
        InputBox.BackgroundTransparency = 0.15
        InputBox.Text = tostring(defaultVal)
        InputBox.PlaceholderText = "10-1000"
        InputBox.TextColor3 = Colors.MintNeon
        InputBox.PlaceholderColor3 = Colors.TextDim
        InputBox.Font = Enum.Font.GothamBold
        InputBox.TextSize = 11
        InputBox.ClearTextOnFocus = false
        InputBox.Parent = Row
        Instance.new("UICorner", InputBox).CornerRadius = UDim.new(0, 5)
        local InputStroke = Instance.new("UIStroke")
        InputStroke.Color = Colors.MintNeon
        InputStroke.Thickness = 1
        InputStroke.Transparency = 0.3
        InputStroke.Parent = InputBox
        local TitleLabel = Instance.new("TextLabel")
        TitleLabel.Size = UDim2.new(0.22, -6, 1, 0)
        TitleLabel.Position = UDim2.new(0.78, 6, 0, 0)
        TitleLabel.BackgroundTransparency = 1
        TitleLabel.Text = labelText
        TitleLabel.TextColor3 = Colors.TextWhite
        TitleLabel.Font = Enum.Font.GothamBold
        TitleLabel.TextSize = 11
        TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
        TitleLabel.Parent = Row
        local currentVal = defaultVal
        local function setSpeedValue(val)
            local clamped = math.clamp(math.floor(val + 0.5), minVal, maxVal)
            currentVal = clamped
            local alpha = (clamped - minVal) / (maxVal - minVal)
            Thumb.Position = UDim2.new(alpha, 9 - (18 * alpha), 0.5, 0)
            TrackValueLabel.Text = tostring(clamped)
            InputBox.Text = tostring(clamped)
            onValueChanged(clamped)
        end
        setSpeedValue(defaultVal)
        local sliding = false
        local function handleTrackInput(input)
            local relX = (input.Position.X - Track.AbsolutePosition.X) / math.max(1, Track.AbsoluteSize.X)
            relX = math.clamp(relX, 0, 1)
            local rawVal = minVal + (maxVal - minVal) * relX
            setSpeedValue(rawVal)
        end
        trackConn(Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                handleTrackInput(input)
            end
        end))
        trackConn(UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                handleTrackInput(input)
            end
        end))
        trackConn(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end))
        trackConn(InputBox.FocusLost:Connect(function()
            local num = tonumber(InputBox.Text)
            if num then
                if num > maxVal then
                    num = maxVal
                elseif num < minVal then
                    num = minVal
                end
                setSpeedValue(num)
            else
                InputBox.Text = tostring(currentVal)
            end
        end))
    end
    local setSystemVisual, setFlyVisual, setNoclipVisual
    local function cleanupPhysics()
        if linearVel then linearVel:Destroy(); linearVel = nil end
        if alignOri then alignOri:Destroy(); alignOri = nil end
        if flyAttachment then flyAttachment:Destroy(); flyAttachment = nil end
    end
    local function stopFly()
        flying = false
        if flyConnection then
            flyConnection:Disconnect()
            flyConnection = nil
        end
        cleanupPhysics()
        local h = humanoid()
        if h then
            h.PlatformStand = false
            h.AutoRotate = true
        end
        local r = root()
        if r then
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
        if setFlyVisual then setFlyVisual(false) end
    end
    local function startFly()
        local r = root()
        local h = humanoid()
        if not enabled or not r or not h then return end
        stopFly()
        flying = true
        h.AutoRotate = false
        h.PlatformStand = true
        if setFlyVisual then setFlyVisual(true) end
        flyAttachment = Instance.new("Attachment")
        flyAttachment.Name = "FlightAttachment"
        flyAttachment.Parent = r
        linearVel = Instance.new("LinearVelocity")
        linearVel.Attachment0 = flyAttachment
        linearVel.MaxForce = math.huge
        linearVel.VectorVelocity = Vector3.zero
        linearVel.Parent = r
        alignOri = Instance.new("AlignOrientation")
        alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
        alignOri.Attachment0 = flyAttachment
        alignOri.MaxTorque = math.huge
        alignOri.Responsiveness = 50
        alignOri.Parent = r
        flyConnection = RunService.RenderStepped:Connect(function()
            local currentRoot = root()
            if not enabled or not flying or not currentRoot then
                stopFly()
                return
            end
            local cam = workspace.CurrentCamera
            local move = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.yAxis end
            if move.Magnitude > 0 then
                move = move.Unit * speed
            end
            linearVel.VectorVelocity = move
            alignOri.CFrame = cam.CFrame
        end)
    end
    local function setNoclip(value)
        noclip = value
        if clipConnection then
            clipConnection:Disconnect()
            clipConnection = nil
        end
        if noclip then
            clipConnection = RunService.Stepped:Connect(function()
                local c = character()
                if not c then return end
                for _, part in ipairs(c:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if savedCollisions[part] == nil then
                            savedCollisions[part] = part.CanCollide
                        end
                        part.CanCollide = false
                    end
                end
            end)
        else
            for part, oldValue in pairs(savedCollisions) do
                if part and part.Parent then
                    part.CanCollide = oldValue
                end
            end
            table.clear(savedCollisions)
        end
        if setNoclipVisual then setNoclipVisual(noclip) end
    end
    setSystemVisual = CreateCheckbox("Flight System", 1, function()
        enabled = not enabled
        setSystemVisual(enabled)
        if not enabled then
            stopFly()
            setNoclip(false)
        end
    end)
    CreateThinDivider(2)
    CreateSliderWithInput("Speed", MIN_SPEED, MAX_SPEED, speed, 3, function(newSpeed)
        speed = newSpeed
    end)
    setFlyVisual = CreateCheckbox("Fly Mode (Key: U)", 4, function()
        if not enabled then return end
        if flying then stopFly() else startFly() end
    end)
    setNoclipVisual = CreateCheckbox("Noclip", 5, function()
        if not enabled then return end
        setNoclip(not noclip)
    end)
    local HintLabel = Instance.new("TextLabel")
    HintLabel.Size = UDim2.new(1, 0, 0, 18)
    HintLabel.BackgroundColor3 = Colors.HeaderBg
    HintLabel.BackgroundTransparency = 0.35
    HintLabel.Text = "WASD: Move | Space/Ctrl: Up/Down"
    HintLabel.TextColor3 = Colors.TextDim
    HintLabel.Font = Enum.Font.GothamMedium
    HintLabel.TextSize = 10
    HintLabel.LayoutOrder = 6
