            TweenService:Create(FlyFloatStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(100, 120, 115)}):Play()
            TweenService:Create(FlyDoveIcon, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(130, 150, 145)}):Play()
