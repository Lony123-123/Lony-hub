        CheckHighlight.Enabled = false
        CheckHighlight.Adornee = nil
        return
    end
    local mousePos = UserInputService:GetMouseLocation()
    CheckTooltip.Position = UDim2.fromOffset(mousePos.X + 16, mousePos.Y + 16)
    local target = mouse.Target
    if target then
        CheckTooltip.Visible = true
        CheckHighlight.Adornee = target
        CheckHighlight.Enabled = true
        local toolAncestor = target:FindFirstAncestorWhichIsA("Tool")
        local modelAncestor = target:FindFirstAncestorWhichIsA("Model")
        TooltipTitle.Text = "Tên khối: " .. target.Name .. " [" .. target.ClassName .. "]"
        if toolAncestor then
            TooltipSub.Text = "Item / Tool: " .. toolAncestor.Name
        elseif modelAncestor and modelAncestor ~= workspace then
            TooltipSub.Text = "Model / Object: " .. modelAncestor.Name
        else
            TooltipSub.Text = "Parent: " .. (target.Parent and target.Parent.Name or "None")
        end
        TooltipPath.Text = target:GetFullName()
    else
        CheckTooltip.Visible = true
        CheckHighlight.Enabled = false
        CheckHighlight.Adornee = nil
        TooltipTitle.Text = "Tên khối: (Không trúng vật thể)"
