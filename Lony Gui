    FlyGuiCleanup = function()
        enabled = false
        stopFly()
        setNoclip(false)
        for _, conn in ipairs(connections) do
            if conn.Connected then
                conn:Disconnect()
            end
        end
        table.clear(connections)
        if FlyScreenGui then FlyScreenGui:Destroy() end
        if FlyBlur then FlyBlur:Destroy() end
    end
