local function ToggleMissNoclip(isEnabled)
    if missNoclipConn then
        missNoclipConn:Disconnect()
        missNoclipConn = nil
    end
    if isEnabled then
        missNoclipConn = RunService.Stepped:Connect(function()
            local c = player.Character
            if not c then return end
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") then
                    if missSavedCollisions[part] == nil then
                        missSavedCollisions[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end)
    else
        for part, oldState in pairs(missSavedCollisions) do
            if part and part.Parent then
                part.CanCollide = oldState
            end
        end
        table.clear(missSavedCollisions)
    end
end

