local espPlayerEnabled = false
local playerEspBillboards = {}
local playerEspConnections = {}
local function ClearPlayerESP(targetPlayer)
    if playerEspBillboards[targetPlayer] then
        playerEspBillboards[targetPlayer]:Destroy()
        playerEspBillboards[targetPlayer] = nil
    end
    if playerEspConnections[targetPlayer] then
        for _, conn in ipairs(playerEspConnections[targetPlayer]) do
            if conn.Connected then conn:Disconnect() end
        end
        playerEspConnections[targetPlayer] = nil
    end
end
local function CreatePlayerESP(targetPlayer)
    if targetPlayer == player then return end
    ClearPlayerESP(targetPlayer)
    playerEspConnections[targetPlayer] = {}
    local function SetupCharacterESP(char)
        if not espPlayerEnabled or not char then return end
        local head = char:WaitForChild("Head", 5) or char:WaitForChild("HumanoidRootPart", 5)
        local hum = char:WaitForChild("Humanoid", 5)
        if not head or not hum or not espPlayerEnabled then return end
        if playerEspBillboards[targetPlayer] then
            playerEspBillboards[targetPlayer]:Destroy()
        end
        local bgui = Instance.new("BillboardGui")
        bgui.Name = "LonyPlayerESP"
        bgui.Adornee = head
        bgui.Size = UDim2.new(0, 180, 0, 42)
        bgui.StudsOffset = Vector3.new(0, 2.8, 0)
        bgui.AlwaysOnTop = true
        bgui.Parent = ScreenGui
        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, 0, 0.5, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = targetPlayer.Name
        nameLbl.TextColor3 = Colors.MintNeon
        nameLbl.TextStrokeTransparency = 0.2
        nameLbl.TextStrokeColor3 = Colors.HeaderBg
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 13
        nameLbl.Parent = bgui
        local hpLbl = Instance.new("TextLabel")
        hpLbl.Size = UDim2.new(1, 0, 0.5, 0)
        hpLbl.Position = UDim2.new(0, 0, 0.5, 0)
        hpLbl.BackgroundTransparency = 1
        hpLbl.TextStrokeTransparency = 0.2
        hpLbl.TextStrokeColor3 = Colors.HeaderBg
        hpLbl.Font = Enum.Font.GothamBold
        hpLbl.TextSize = 12
        hpLbl.Parent = bgui
        local function UpdateHealth()
            if hum and hum.Parent then
                local hp = math.floor(hum.Health + 0.5)
                local maxHp = math.floor(hum.MaxHealth + 0.5)
                hpLbl.Text = string.format("HP: %d / %d", hp, maxHp)
                local ratio = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
                hpLbl.TextColor3 = Color3.fromHSV(ratio * 0.33, 0.9, 1)
            end
        end
        UpdateHealth()
        table.insert(playerEspConnections[targetPlayer], hum.HealthChanged:Connect(UpdateHealth))
        table.insert(playerEspConnections[targetPlayer], hum:GetPropertyChangedSignal("MaxHealth"):Connect(UpdateHealth))
        playerEspBillboards[targetPlayer] = bgui
    end
    if targetPlayer.Character then
        task.spawn(SetupCharacterESP, targetPlayer.Character)
    end
    table.insert(playerEspConnections[targetPlayer], targetPlayer.CharacterAdded:Connect(SetupCharacterESP))
end
local playerAddedEspConn = nil
local playerRemovingEspConn = nil
local function TogglePlayerESP(isEnabled)
    espPlayerEnabled = isEnabled
    if isEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                CreatePlayerESP(p)
            end
        end
        playerAddedEspConn = Players.PlayerAdded:Connect(function(p)
            if espPlayerEnabled then
                CreatePlayerESP(p)
            end
        end)
        playerRemovingEspConn = Players.PlayerRemoving:Connect(function(p)
            ClearPlayerESP(p)
        end)
    else
        if playerAddedEspConn then playerAddedEspConn:Disconnect(); playerAddedEspConn = nil end
        if playerRemovingEspConn then playerRemovingEspConn:Disconnect(); playerRemovingEspConn = nil end
        for p, _ in pairs(playerEspBillboards) do
            ClearPlayerESP(p)
        end
        for p, _ in pairs(playerEspConnections) do
            ClearPlayerESP(p)
        end
    end
end
