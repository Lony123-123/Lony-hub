local espNpcEnabled = false
local npcEspBillboards = {}
local npcDescendantAddedConn = nil
local npcDescendantRemovingConn = nil

local function IsPlayerCharacter(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function RemoveNpcESP(model)
    if npcEspBillboards[model] then
        npcEspBillboards[model]:Destroy()
        npcEspBillboards[model] = nil
    end
end

local function AttachNpcESP(model)
    if not espNpcEnabled or not model or not model:IsA("Model") then return end
    if IsPlayerCharacter(model) then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local adornee = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not adornee then return end
    RemoveNpcESP(model)

    local bgui = Instance.new("BillboardGui")
    bgui.Name = "LonyNpcESP"
    bgui.Adornee = adornee
    bgui.Size = UDim2.new(0, 180, 0, 26)
    bgui.StudsOffset = Vector3.new(0, 2.5, 0)
    bgui.AlwaysOnTop = true
    bgui.Parent = ScreenGui

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, 0, 1, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = model.Name
    nameLbl.TextColor3 = Colors.MintNeon
    nameLbl.TextStrokeTransparency = 0.2
    nameLbl.TextStrokeColor3 = Colors.HeaderBg
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 12
    nameLbl.Parent = bgui

    model:GetPropertyChangedSignal("Name"):Connect(function()
        if nameLbl and nameLbl.Parent then
            nameLbl.Text = model.Name
        end
    end)

    npcEspBillboards[model] = bgui
end

local function ToggleNpcESP(isEnabled)
    espNpcEnabled = isEnabled
    if isEnabled then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Parent and obj.Parent:IsA("Model") then
                AttachNpcESP(obj.Parent)
            end
        end
        npcDescendantAddedConn = workspace.DescendantAdded:Connect(function(obj)
            if not espNpcEnabled then return end
            if obj:IsA("Humanoid") then
                task.defer(function()
                    if obj.Parent and obj.Parent:IsA("Model") then
                        AttachNpcESP(obj.Parent)
                    end
                end)
            elseif obj:IsA("BasePart") and (obj.Name == "Head" or obj.Name == "HumanoidRootPart") then
                task.defer(function()
                    local model = obj.Parent
                    if model and model:IsA("Model") and not npcEspBillboards[model] and model:FindFirstChildOfClass("Humanoid") then
                        AttachNpcESP(model)
                    end
                end)
            end
        end)
        npcDescendantRemovingConn = workspace.DescendantRemoving:Connect(function(obj)
            if obj:IsA("Model") and npcEspBillboards[obj] then
                RemoveNpcESP(obj)
            end
        end)
    else
        if npcDescendantAddedConn then npcDescendantAddedConn:Disconnect(); npcDescendantAddedConn = nil end
        if npcDescendantRemovingConn then npcDescendantRemovingConn:Disconnect(); npcDescendantRemovingConn = nil end
        for model, _ in pairs(npcEspBillboards) do
            RemoveNpcESP(model)
        end
    end
end

globalEnv.LonyGlobalCleanups.NpcESP = function() ToggleNpcESP(false) end

