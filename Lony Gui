local function ToggleToolCheckPart(isEnabled)
    toolCheckEnabled = isEnabled
    holdingCheck = false
    CheckTooltip.Visible = false
    CheckHighlight.Enabled = false
    CheckHighlight.Adornee = nil
    if checkRenderConn then checkRenderConn:Disconnect(); checkRenderConn = nil end
    if checkInputBeganConn then checkInputBeganConn:Disconnect(); checkInputBeganConn = nil end
    if checkInputEndedConn then checkInputEndedConn:Disconnect(); checkInputEndedConn = nil end
    if isEnabled then
        checkInputBeganConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                holdingCheck = true
                UpdateToolCheckPart()
            end
