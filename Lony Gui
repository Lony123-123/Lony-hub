    local function IsPointInsidePart(point, part)
        local localPos = part.CFrame:PointToObjectSpace(point)
        local halfSize = part.Size * 0.5
        return math.abs(localPos.X) <= (halfSize.X + 0.15)
           and math.abs(localPos.Y) <= (halfSize.Y + 0.15)
           and math.abs(localPos.Z) <= (halfSize.Z + 0.15)
    end

    local function GetAccurateHoveredPart()
        local cam = workspace.CurrentCamera
        if not cam then return nil end

        local mousePos = UserInputService:GetMouseLocation()
        local unitRay = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
        local maxDistance = 1000
        local char = player.Character

        local filterList = {char}
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.IgnoreWater = true

        local bestRayHit = nil
        local bestRayDist = maxDistance

        for _ = 1, 10 do
            rayParams.FilterDescendantsInstances = filterList
            local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * maxDistance, rayParams)
            if result and result.Instance then
                local hitPart = result.Instance
                if hitPart.Transparency >= 0.98 and not hitPart.CanCollide then
                    if not bestRayHit then
                        bestRayHit = hitPart
                        bestRayDist = result.Distance
                    end
                    table.insert(filterList, hitPart)
                else
                    bestRayHit = hitPart
                    bestRayDist = result.Distance
                    break
                end
            else
                break
            end
        end

        local searchLimit = bestRayHit and math.min(bestRayDist, 250) or 250
        local stepSize = 3
        local overlapParams = OverlapParams.new()
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude
        overlapParams.FilterDescendantsInstances = {char}

        for dist = 2, searchLimit, stepSize do
            local samplePoint = unitRay.Origin + unitRay.Direction * dist
            local nearbyParts = workspace:GetPartBoundsInRadius(samplePoint, 3.5, overlapParams)
            for _, part in ipairs(nearbyParts) do
                if part:IsA("BasePart") and part ~= workspace.Terrain then
                    if not part.CanQuery or not part.CanCollide then
                        local localOrigin = part.CFrame:PointToObjectSpace(unitRay.Origin)
                        local localDir = part.CFrame:VectorToObjectSpace(unitRay.Direction)
                        local half = (part.Size * 0.5) + Vector3.new(0.1, 0.1, 0.1)

                        local tMin = -math.huge
                        local tMax = math.huge
                        local hitOBB = true

                        for _, axis in ipairs({"X", "Y", "Z"}) do
                            local o = localOrigin[axis]
                            local d = localDir[axis]
                            local h = half[axis]
                            if math.abs(d) < 1e-6 then
                                if o < -h or o > h then
                                    hitOBB = false
                                    break
                                end
                            else
                                local t1 = (-h - o) / d
                                local t2 = (h - o) / d
                                if t1 > t2 then t1, t2 = t2, t1 end
                                if t1 > tMin then tMin = t1 end
                                if t2 < tMax then tMax = t2 end
                                if tMin > tMax or tMax < 0 then
                                    hitOBB = false
                                    break
                                end
                            end
                        end

                        if hitOBB and tMin <= bestRayDist and tMin >= 0 then
                            if part.Transparency < 0.99 or not bestRayHit then
                                bestRayHit = part
                                bestRayDist = tMin
                            end
                        end
                    end
                end
            end
        end

        if not bestRayHit or bestRayDist > 150 then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj ~= workspace.Terrain and (not obj.CanQuery or not obj.CanCollide) then
                    if not (char and obj:IsDescendantOf(char)) then
                        local toPart = obj.Position - unitRay.Origin
                        local proj = toPart:Dot(unitRay.Direction)
                        if proj > 0 and proj < bestRayDist then
                            local closestPointOnRay = unitRay.Origin + unitRay.Direction * proj
                            if IsPointInsidePart(closestPointOnRay, obj) then
                                bestRayHit = obj
                                bestRayDist = proj
                            end
                        end
                    end
                end
            end
        end

        return bestRayHit
    end

    local function IsMouseOverGui()
        local mPos = UserInputService:GetMouseLocation()
        local guiInset = GuiService:GetGuiInset()
        local adjustedX, adjustedY = mPos.X, mPos.Y - guiInset.Y

        local function checkFrame(frame)
            if not frame or not frame.Parent or not frame.Visible then return false end
            local pos = frame.AbsolutePosition
            local size = frame.AbsoluteSize
            return adjustedX >= pos.X and adjustedX <= (pos.X + size.X)
               and adjustedY >= pos.Y and adjustedY <= (pos.Y + size.Y)
        end

        return checkFrame(ToolMainFrame) or checkFrame(ToolFloatBtn) or checkFrame(MainFrame) or checkFrame(FloatBtn)
    end

